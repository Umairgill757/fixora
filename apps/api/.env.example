# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL="file:./dev.db"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
# Production: switch to PostgreSQL, e.g.
# DATABASE_URL="postgresql://user:pass@host:5432/marketplace"

# --- JazzCash (Pakistani payments) ---
# Get these from JazzCash merchant onboarding (corporateonboarding.jazzcash.com.pk).
# Sandbox credentials are issued with the sandbox merchant account.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Defaults to the JazzCash sandbox hosted-checkout page; override for production:
# JAZZCASH_GATEWAY_URL=https://payments.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
# Public URL where JazzCash POSTs the payment result. Must be reachable from the
# internet in production (use a tunnel like ngrok for local testing):
# JAZZCASH_RETURN_URL=https://your-domain.com/v1/payments/callback/jazzcash
