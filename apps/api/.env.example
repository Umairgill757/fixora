# Copy to .env and fill in. Never commit real secrets.
# Neon (free PostgreSQL) — create a project at neon.tech and paste the connection string:
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.neon.tech/fixora?sslmode=require"
JWT_SECRET="change-me-to-a-long-random-string"
PORT=3001
# Production: set this to your Vercel URL, e.g. "https://fixora.vercel.app"
WEB_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"

# --- JazzCash (Pakistani payments) ---
# Get these from JazzCash merchant onboarding (corporateonboarding.jazzcash.com.pk).
# Sandbox credentials are issued with the sandbox merchant account.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Defaults to the JazzCash sandbox hosted-checkout page; override for production:
# JAZZCASH_GATEWAY_URL=https://payments.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
# Public URL where JazzCash POSTs the payment result. Must be reachable from the
# internet in production (use a tunnel like ngrok for local testing):
# JAZZCASH_RETURN_URL=https://your-domain.com/v1/payments/callback/jazzcash

# --- Platform ---
# Commission % taken on each invoiced booking (default 10)
# PLATFORM_COMMISSION_PCT=10

# --- Notifications (all optional; console-logged when unset) ---
# Email via Resend:
# RESEND_API_KEY=
# RESEND_FROM="Fixora <noreply@fixora.pk>"
# SMS via Twilio:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# Push via Expo (for future mobile apps):
# EXPO_PUSH_ENABLED=true
